# Port to listen on. Hosting platforms (Render, Railway) set this for you.
PORT=4000
# Where the client is served from, with no trailing slash. Several origins can
# be listed separated by commas, e.g. the deployed site and a LAN address:
# CLIENT_ORIGIN=https://my-board.vercel.app,http://192.168.1.20:5173
CLIENT_ORIGIN=http://localhost:5173
# Local MongoDB, or an Atlas connection string ending in /whiteboard
MONGODB_URI=mongodb://127.0.0.1:27017/whiteboard
